# Image to run: a published release (pin the full version to update on your terms) or your own build
PI_SHARE_IMAGE=ghcr.io/ontech7/pi-share:0.4
# Where the links point to, as the recipients see it (the tunnel hostname)
PUBLIC_URL=https://share.example.com
# Folder whose files can be shared, mounted read-only
STORAGE_PATH=/mnt/storage
# Database and master key (back it up, keep it private)
DATA_PATH=/var/lib/pi-share
# Host folder for the unix sockets (owned by uid 10001, mode 0750)
SOCKET_PATH=/run/pi-share
# Folders that can never be browsed or shared, comma separated, relative to STORAGE_PATH
DENY_PATHS=
# Optional "sha256 size [path]" list of files that need a confirmation before sharing
SENSITIVE_FILE=
# Admin language: en, it, or empty to follow the browser
ADMIN_LANG=
ADMIN_BIND=127.0.0.1
TZ=Europe/Rome
