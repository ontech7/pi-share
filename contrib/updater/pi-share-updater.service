[Unit]
Description=pi-share: install a newer release requested in the admin
Requires=docker.service
After=docker.service pi-share.service
# It spaces its own runs out (COOLDOWN), so a flood of requests never parks the path unit in "failed".
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/pi-share/pi-share-updater.py
# The worst case of every step, rollback included. On timeout it gets SIGTERM and rolls back within TimeoutStopSec;
# KillMode=mixed leaves the docker commands of that rollback alone until then.
TimeoutStartSec=40min
TimeoutStopSec=10min
KillMode=mixed
# Optional: GH_TOKEN=<a token with no scopes> lets it verify the build provenance with the GitHub CLI.
EnvironmentFile=-/etc/pi-share/updater.secret
Environment=DOCKER_CONFIG=/var/lib/pi-share-update/docker
Environment=HOME=/var/lib/pi-share-update/gh GH_CONFIG_DIR=/var/lib/pi-share-update/gh
# Root only because it drives Docker, and the Docker socket is root anyway: this sandbox limits mistakes, not an
# attacker. Adjust ReadWritePaths if your compose file, data or update folders live elsewhere (see updater.env).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/etc/pi-share -/var/lib/pi-share -/var/lib/pi-share-update -/run/docker.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
# Also once at boot: a switch a power cut interrupted is undone before anyone notices.
WantedBy=multi-user.target
