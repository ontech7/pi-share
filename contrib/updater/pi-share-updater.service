[Unit]
Description=pi-share: install a newer release requested in the admin
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/pi-share/pi-share-updater.py
TimeoutStartSec=20min
# Root only because it drives Docker. Everything else stays read-only: adjust ReadWritePaths if your
# compose file, data or update folders live elsewhere (see updater.env).
Environment=DOCKER_CONFIG=/var/lib/pi-share-update/docker
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/pi-share /var/lib/pi-share /var/lib/pi-share-update /run/docker.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
