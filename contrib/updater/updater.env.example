# /etc/pi-share/updater.env — owned by root, mode 0644 (the updater refuses it otherwise)
REPO=ontech7/pi-share
IMAGE=ghcr.io/ontech7/pi-share
# The compose files (several separated by ":", like Docker's COMPOSE_FILE) and the .env used with them;
# PI_SHARE_IMAGE in that .env is what the updater changes
COMPOSE_FILE=/etc/pi-share/compose.yaml:/etc/pi-share/compose.updater.yaml
ENV_FILE=/etc/pi-share/.env
# pi-share's DATA_DIR on the host, copied before every switch
DATA_DIR=/var/lib/pi-share
# Mounted in the admin: request read-write, status read-only
REQUEST_DIR=/var/lib/pi-share-update/request
STATUS_DIR=/var/lib/pi-share-update/status
BACKUP_DIR=/var/lib/pi-share-update/backup
# Seconds the new version has to become healthy before the previous one comes back
HEALTH_TIMEOUT=120
# Seconds between two runs, so a flood of requests cannot keep Docker and GitHub busy
COOLDOWN=15
# Build provenance, checked with the GitHub CLI (gh) against the exact digest that will run. It needs a token:
# GH_TOKEN=<a token with no scopes> in /etc/pi-share/updater.secret (root, 0600).
# auto: verify when gh and a token are there; required: refuse without them; off
VERIFY_PROVENANCE=auto
# The workflow that must have built and signed the image
SIGNER_WORKFLOW=.github/workflows/release.yml
